# --- Required ---
ANTHROPIC_API_KEY=
# Required when RERANKER=cohere (the default)
COHERE_API_KEY=

# --- Models ---
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COHERE_RERANK_MODEL=rerank-v3.5
# cohere | local (local = sentence-transformers cross-encoder, no API key)
RERANKER=cohere
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Weaviate ---
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=DocumentChunk

# --- Chunking (tokens) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5
HYBRID_CANDIDATES=20
HYBRID_ALPHA=0.5
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.2

# --- CI quality gates (Phase 3) ---
THRESHOLD_FAITHFULNESS=0.80
THRESHOLD_ANSWER_RELEVANCY=0.70
THRESHOLD_CONTEXT_RECALL=0.70

CORS_ORIGINS=http://localhost:5173
