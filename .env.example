# --- Storage ---
DATABASE_URL=sqlite:///data/askdocs.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# --- Models ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# --- Chunking (tokens) ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval depth ---
RETRIEVE_K=20
RERANK_K=5

# --- Prompt ---
PROMPT_VERSION=answer_v1
