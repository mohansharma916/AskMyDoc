# --- API ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
INGEST_ROOT=data
WARMUP_MODELS=true

# --- Storage ---
DATABASE_URL=sqlite:///data/askdocs.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_EFFORT=low
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=30.0
OLLAMA_URL=http://localhost:11434

# --- Models ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RERANK_MODEL=BAAI/bge-reranker-base

# --- Chunking (tokens) ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval depth ---
RETRIEVE_K=20
RERANK_K=5
ABSTAIN_THRESHOLD=0.03

# --- Prompt ---
PROMPTS_DIR=prompts
PROMPT_VERSION=answer_v1


# --- Tracing (OpenTelemetry over OTLP/HTTP) ---
# Phoenix: docker compose --profile tracing up -d phoenix, then open http://localhost:6006
# Langfuse: OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
#           OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 public_key:secret_key>"
TRACING_ENABLED=false
OTEL_ENDPOINT=http://localhost:6006/v1/traces
