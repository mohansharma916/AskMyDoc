# --- Storage ---
DATABASE_URL=sqlite:///data/askdocs.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_EFFORT=low
# OLLAMA_URL=http://localhost:11434   (with LLM_PROVIDER=ollama, LLM_MODEL=llama3.1)

# --- Models ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# --- Chunking (tokens) ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval depth ---
RETRIEVE_K=20
RERANK_K=5
ABSTAIN_THRESHOLD=0.1

# --- Prompt ---
PROMPT_VERSION=answer_v1
